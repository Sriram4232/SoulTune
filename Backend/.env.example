# Copy settings into Backend/.env. Guest demo works without keys; account login requires email OTP.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Used only if the configured model is unavailable or retired. Empty disables model retry.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Leave empty for durable local SQLite. Configured MongoDB must be reachable.
MONGODB_URI=
MONGODB_DATABASE=ai_music_curator
DATABASE_PATH=data/curator.sqlite3
# Empty scans fallback_songs/ under the project folder. Set a path for another folder.
LOCAL_MUSIC_DIR=
ALLOWED_ORIGINS=https://soul-tune-kappa.vercel.app,https://soultune-zctz.onrender.com,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8000,http://127.0.0.1:8000
# In production on Render with Vercel frontend: COOKIE_SECURE=true and COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_HOURS=168
GUEST_SESSION_HOURS=24
ENVIRONMENT=development

# Email OTP is required for registration and every account login.
# Choose smtp (mail server + app password) OR resend (email API key).
MAIL_PROVIDER=smtp
MAIL_FROM=Vibetune <you@example.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
# Use your mail provider's app password, not your regular account password.
SMTP_PASSWORD=
# starttls for port 587; ssl for port 465. Unencrypted SMTP is not supported.
SMTP_SECURITY=starttls
# Only needed when MAIL_PROVIDER=resend. MAIL_FROM must use a verified sender.
RESEND_API_KEY=
# Required: a private random string of at least 32 characters, shared across server workers.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
OTP_SECRET=
